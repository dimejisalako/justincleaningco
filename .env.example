# Copy this file to .env and fill in the values.

# PostgreSQL connection string. Local example below; on Vercel use the Postgres (Neon) URL.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/justin"

# Public site URL, used in email links
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp click-to-chat number, international format, digits only (no +, spaces or dashes).
# Example for a US number: 12145550123
NEXT_PUBLIC_WHATSAPP_NUMBER="[PHONE_NUMBER_IN_INTERNATIONAL_FORMAT]"

# Contact email shown in the footer (placeholder until you have a real address)
NEXT_PUBLIC_CONTACT_EMAIL="hello@example.com"

# Admin panel password (set a long random value in production)
ADMIN_PASSWORD="change-me-admin-password"

# Secret used to sign the admin session cookie. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Email provider placeholder. Leave EMAIL_PROVIDER_API_KEY empty in development:
# emails are then printed to the server console instead of being sent.
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM="Justin Cleaning Co. <bookings@example.com>"
